# Copy to .env and adjust. Every variable maps to a field in app/config.py.

ENVIRONMENT=development
LOG_LEVEL=INFO
PUBLIC_APP_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:8000

DATABASE_URL=postgresql+asyncpg://flowforge:flowforge@localhost:5432/flowforge
REDIS_URL=redis://localhost:6379/0

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production-at-least-32-bytes
COOKIE_SECURE=false

# Fernet key that encrypts the credential vault. Required to save credentials.
# Generate with:
#   openssl rand -base64 32 | tr "+/" "-_"
# or: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing or changing it makes every stored credential unreadable.
CREDENTIALS_KEY=

# LLM via OpenRouter (https://openrouter.ai/keys).
# Set LLM_PROVIDER=fake to run without a key (deterministic offline results for demos/tests).
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_CHAT_MODEL=openai/gpt-4o-mini
# JSON list of models OpenRouter falls back to if the main model fails,
# e.g. ["meta-llama/llama-3.3-70b-instruct"]. Pick current model IDs from openrouter.ai/models.
OPENROUTER_FALLBACK_MODELS=[]

# Outbound HTTP from workflow steps. Private and loopback addresses are blocked (SSRF).
# Set to true only on a developer machine to call services on localhost.
ALLOW_PRIVATE_NETWORK_REQUESTS=false

# Execution limits
RUN_JOB_TIMEOUT_SECONDS=900
# Prometheus endpoint served by the worker process (0 disables it)
WORKER_METRICS_PORT=9100
DEFAULT_STEP_TIMEOUT_SECONDS=30
MAX_STEP_TIMEOUT_SECONDS=300

# Mailpit in development: open http://localhost:8025 to read sent emails
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
EMAIL_FROM=FlowForge <no-reply@flowforge.local>
